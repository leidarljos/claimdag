/* WorkGraph widgets on Day. Shared tokens: day.tcss */

Screen {
    layout: vertical;
}

Tree {
    height: 1fr;
    width: 1fr;
    background: #eeeeee;
    color: #262626;
}

Tree > .tree--cursor {
    background: #c8d6f0;
    color: #262626;
}

Tree > .tree--highlight {
    text-style: bold;
}

Tree > .tree--guides {
    color: #2F64D2;
}
